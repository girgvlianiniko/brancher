# Read access to the repositories you watch. Without it, private repos cannot be
# cloned and the GitHub API is limited to 60 requests an hour.
GITHUB_TOKEN=

# Cloned on first boot, comma separated, owner/repo.
# BRANCHER_CLONE=core-platform-handover/oribet-monorepo,core-platform-handover/oribet-admin,core-platform-handover/api-laravel,core-platform-handover/websocket-node,core-platform-handover/chat-node,core-platform-handover/agentpay

# Alerts link back to the board, so tell it where it lives.
# BRANCHER_PUBLIC_URL=https://brancher.example.com

# Published port on the host.
# BRANCHER_PORT=4317

# Only for running outside a container.
# BRANCHER_DATA_DIR=./server/data
# BRANCHER_REPOS_DIR=..
# BRANCHER_HOST=127.0.0.1
